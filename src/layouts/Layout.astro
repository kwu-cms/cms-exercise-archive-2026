---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE, FOOTER_LINKS } from '../data/site';
import { withBase } from '../lib/base-url';

interface Props {
  title: string;
  description?: string;
  accent?: 'takawo' | 'mizuno' | 'yao' | null;
}

const {
  title,
  description = `${SITE.subtitle}｜${SITE.university}`,
  accent = null,
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="fonts-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <style is:inline>
      html.fonts-loading body {
        opacity: 0;
      }
    </style>
    <script is:inline>
      (function () {
        const root = document.documentElement;

        function reveal() {
          root.classList.remove('fonts-loading');
          root.classList.add('fonts-ready');
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveal();
          return;
        }

        Promise.race([
          document.fonts.ready,
          new Promise(function (resolve) {
            setTimeout(resolve, 2000);
          }),
        ]).then(reveal);
      })();
    </script>
    <title>{title} ｜ {SITE.title}</title>
  </head>
  <body class="bg-paper text-ink font-body antialiased">
    <SiteHeader accent={accent} />

    <main>
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-5xl px-6 py-10">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-[0.6875rem]">
          {FOOTER_LINKS.map((link) =>
            link.href ? (
              <a
                href={withBase(link.href)}
                class="text-ink-soft transition-colors hover:text-ink hover:underline"
                {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
              </a>
            ) : (
              <span class="text-ink-soft/50">{link.label}</span>
            )
          )}
        </nav>
        <p class="mt-6 font-mono text-[0.6875rem] text-ink-soft">
          {SITE.title}（{SITE.year}年度）｜{SITE.university}
        </p>
      </div>
    </footer>
  </body>
</html>
