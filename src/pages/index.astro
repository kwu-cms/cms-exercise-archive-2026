---
import Layout from '../layouts/Layout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import OutcomeSection from '../components/OutcomeSection.astro';
import ScheduleSection from '../components/ScheduleSection.astro';
import { TEACHERS, CROSS_CUTTING } from '../data/sessions';
import { SITE, SET_META } from '../data/site';
import { accentText, accentBg, accentBorder } from '../lib/accent';
import { withBase } from '../lib/base-url';
---

<Layout title="TOP">
  <!-- HERO -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-ink-soft">
        {SITE.university}｜{SITE.year}年度
      </p>
      <h1 class="mt-4 font-display text-2xl leading-snug text-ink sm:text-3xl">
        {SITE.title}
      </h1>
      <p class="mt-3 font-display text-lg leading-relaxed text-ink-soft sm:text-xl">
        {SITE.heroTagline}
      </p>
      <p class="mt-6 text-sm leading-loose text-ink-soft">{SITE.heroLead}</p>
    </div>
  </section>

  <OutcomeSection variant="overview" />

  <!-- 3つの演習 -->
  <section class="border-b border-line" id="themes">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <h2 class="font-display text-xl text-ink">{CROSS_CUTTING.sectionTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">{CROSS_CUTTING.processIntro}</p>
      <div class="mt-5">
        <ProcessSteps />
      </div>
      <p class="mt-6 text-sm leading-relaxed text-ink-soft">{CROSS_CUTTING.themeConnection}</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-3">
        {(['takawo', 'mizuno', 'yao'] as const).map((t) => {
          const meta = SET_META[t];
          return (
            <a
              href={withBase(`/${t}/`)}
              class:list={['group flex flex-col border p-5 transition-colors hover:bg-paper-dim', accentBorder[t]]}
            >
              <span class:list={['inline-block w-fit px-2 py-0.5 font-mono text-[0.625rem] uppercase tracking-wider text-paper', accentBg[t]]}>
                {String(TEACHERS[t].order).padStart(2, '0')}｜{meta.theme}
              </span>
              <h3 class="mt-3 font-display text-base leading-snug text-ink">{meta.tagline}</h3>
              <p class="mt-2 font-display text-sm leading-relaxed text-ink-soft">「{meta.question}」</p>
              {meta.description && (
                <p class="mt-3 flex-1 text-xs leading-relaxed text-ink-soft">{meta.description}</p>
              )}
              <dl class="mt-4 space-y-1 font-mono text-[0.6875rem] text-ink-soft">
                <div class="flex justify-between gap-2">
                  <dt>担当</dt>
                  <dd class="text-ink">{TEACHERS[t].name}</dd>
                </div>
                <div class="flex justify-between gap-2">
                  <dt>回数</dt>
                  <dd class="text-ink">{meta.sessions}</dd>
                </div>
              </dl>
              <span class:list={['mt-4 font-mono text-[0.6875rem] group-hover:underline', accentText[t]]}>
                テーマを見る →
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <ScheduleSection />
</Layout>
