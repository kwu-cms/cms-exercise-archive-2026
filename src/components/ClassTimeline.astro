---
import SessionKindLabel from './SessionKindLabel.astro';
import SessionHashtagTags from './SessionHashtagTags.astro';
import type { Round } from '../data/rounds/types';
import type { Teacher } from '../data/sessions';

interface Props {
  rounds: Round[];
  accent: Teacher;
  accentText: string;
  accentBg: string;
  pointsLabel?: string;
  taskLabel?: string;
}

const {
  rounds,
  accent,
  accentText,
  accentBg,
  pointsLabel = '授業のねらい',
  taskLabel = '取り組み',
} = Astro.props;

const nextSessionNo = rounds[rounds.length - 1]?.sessionNo + 1;
---

<ol class:list={['class-timeline', `class-timeline--${accent}`]}>
  {rounds.map((round, i) => {
    const isLast = i === rounds.length - 1;
    return (
      <li class:list={['class-timeline__item', isLast && 'class-timeline__item--last']}>
        <div
          class:list={['class-timeline__rail', isLast && 'class-timeline__rail--extended']}
          aria-hidden="true"
        >
          <span class:list={['class-timeline__step font-mono', accentText]}>
            {String(round.sessionNo).padStart(2, '0')}
          </span>
          <span class:list={['class-timeline__dot', accentBg]}></span>
          {!isLast && <span class="class-timeline__line"></span>}
          {isLast && (
            <>
              <span class="class-timeline__line-dashed"></span>
              <span class:list={['class-timeline__step class-timeline__step--next font-mono', accentText]}>
                {String(nextSessionNo).padStart(2, '0')}
              </span>
            </>
          )}
        </div>

        <article class="class-timeline__card">
        <header class="class-timeline__header">
          <p class:list={['class-timeline__phase font-mono', accentText]}>{round.phase}</p>
          <div class="class-timeline__meta">
            <span class="font-mono text-xs font-medium text-ink">
              第{String(round.sessionNo).padStart(2, '0')}回
            </span>
            <SessionKindLabel kind={round.kind} accent={accent} />
            <span class="font-mono text-[0.6875rem] text-ink-soft">{round.date}</span>
          </div>
          <h3 class="class-timeline__title font-display">{round.title}</h3>
        </header>

        <p class="class-timeline__summary">{round.summary}</p>

        {round.points.length > 0 && (
          <div class="class-timeline__points-block">
            <p class:list={['class-timeline__points-label font-mono', accentText]}>{pointsLabel}</p>
            <ul class="class-timeline__points">
              {round.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}

        {round.task && (
          <footer class="class-timeline__task">
            <span class:list={['class-timeline__task-label font-mono', accentText]}>{taskLabel}</span>
            <span>{round.task}</span>
          </footer>
        )}

        <div class="class-timeline__tags">
          <SessionHashtagTags
            sessionNo={round.sessionNo}
            accent={accent}
          />
        </div>
      </article>
    </li>
    );
  })}
</ol>

<style>
  .class-timeline {
    --timeline-rail: 2.75rem;
    --timeline-gap: 1.25rem;
    --timeline-rail-color: color-mix(in srgb, var(--color-ink-soft) 45%, var(--color-line));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .class-timeline--takawo {
    --timeline-rail-color: color-mix(in srgb, var(--color-takawo) 35%, var(--color-line));
  }

  .class-timeline--mizuno {
    --timeline-rail-color: color-mix(in srgb, var(--color-mizuno) 35%, var(--color-line));
  }

  .class-timeline--yao {
    --timeline-rail-color: color-mix(in srgb, var(--color-yao) 35%, var(--color-line));
  }

  .class-timeline__item {
    display: grid;
    grid-template-columns: var(--timeline-rail) minmax(0, 1fr);
    column-gap: var(--timeline-gap);
    padding-bottom: 2rem;
  }

  .class-timeline__item:last-child {
    padding-bottom: 0;
  }

  .class-timeline__item--last {
    align-items: stretch;
  }

  .class-timeline__rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.125rem;
  }

  .class-timeline__rail--extended {
    height: 100%;
    min-height: 100%;
    padding-bottom: 0;
  }

  .class-timeline__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.875rem;
    padding: 0.2rem 0.35rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    border: 1px solid color-mix(in srgb, var(--color-line) 80%, var(--color-ink-soft));
    background: var(--color-paper);
  }

  .class-timeline--takawo .class-timeline__step {
    border-color: color-mix(in srgb, var(--color-takawo) 38%, var(--color-line));
  }

  .class-timeline--mizuno .class-timeline__step {
    border-color: color-mix(in srgb, var(--color-mizuno) 38%, var(--color-line));
  }

  .class-timeline--yao .class-timeline__step {
    border-color: color-mix(in srgb, var(--color-yao) 38%, var(--color-line));
  }

  .class-timeline__step--next {
    margin-top: auto;
    border-style: dashed;
    color: var(--color-ink-soft);
    background: color-mix(in srgb, var(--color-paper-dim) 55%, var(--color-paper));
  }

  .class-timeline__dot {
    z-index: 1;
    margin-top: 0.5rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    border: 2px solid var(--color-paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-line) 70%, transparent);
  }

  .class-timeline__line {
    position: absolute;
    top: 1.75rem;
    bottom: -2rem;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background: var(--timeline-rail-color);
  }

  .class-timeline__line-dashed {
    flex: 1 1 auto;
    width: 1px;
    min-height: 1.5rem;
    margin: 0.5rem 0 0.375rem;
    /* 15 5 5 5 15 5 5 — 実線・空白・実線・空白・実線・空白・実線 */
    background: repeating-linear-gradient(
      to bottom,
      var(--timeline-rail-color) 0,
      var(--timeline-rail-color) 15px,
      transparent 15px,
      transparent 20px,
      var(--timeline-rail-color) 20px,
      var(--timeline-rail-color) 25px,
      transparent 25px,
      transparent 30px,
      var(--timeline-rail-color) 30px,
      var(--timeline-rail-color) 45px,
      transparent 45px,
      transparent 50px,
      var(--timeline-rail-color) 50px,
      var(--timeline-rail-color) 55px,
      transparent 55px,
      transparent 62px
    );
  }

  .class-timeline__item:last-child .class-timeline__line {
    display: none;
  }

  .class-timeline__card {
    border: 1px solid var(--color-line);
    border-top: 2px solid;
    background: var(--color-paper);
    padding: 1.25rem 1.5rem;
  }

  .class-timeline--takawo .class-timeline__card {
    border-top-color: var(--color-takawo);
  }

  .class-timeline--mizuno .class-timeline__card {
    border-top-color: var(--color-mizuno);
  }

  .class-timeline--yao .class-timeline__card {
    border-top-color: var(--color-yao);
  }

  .class-timeline__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .class-timeline__phase {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .class-timeline__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .class-timeline__title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-ink);
  }

  .class-timeline__summary {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }

  .class-timeline__points-block {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px solid color-mix(in srgb, var(--color-line) 65%, transparent);
  }

  .class-timeline__points-label {
    margin: 0 0 0.5rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .class-timeline__points {
    margin: 0;
    padding: 0 0 0 1.125rem;
    list-style: disc;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .class-timeline__points li + li {
    margin-top: 0.375rem;
  }

  .class-timeline__points li::marker {
    color: color-mix(in srgb, var(--color-ink-soft) 55%, transparent);
  }

  .class-timeline__task {
    margin-top: 1rem;
    padding-top: 0.875rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-line) 75%, transparent);
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .class-timeline__task-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .class-timeline__tags {
    margin-top: 2rem;
    padding-top: 1.125rem;
    border-top: 1px solid color-mix(in srgb, var(--color-line) 55%, transparent);
  }

  .class-timeline__task + .class-timeline__tags {
    border-top-style: dashed;
  }

  @media (min-width: 640px) {
    .class-timeline {
      --timeline-rail: 3.25rem;
      --timeline-gap: 1.5rem;
    }

    .class-timeline__card {
      padding: 1.5rem 1.75rem;
    }

    .class-timeline__title {
      font-size: 1.25rem;
    }
  }
</style>
