---
import { TEACHERS, type Teacher } from '../data/sessions';
import { SET_META } from '../data/site';
import { MIZUNO_HERO_VIDEOS } from '../data/mizuno/hero-videos';
import { YAO_HERO_VIDEOS } from '../data/yao/hero-videos';
import { withBase } from '../lib/base-url';
import { pickSsrHeroVideos } from '../lib/hero-video-ssr';
import { buildHeroOrbitCards } from '../lib/takawo/hero-card-orbit/build-cards';
import type { NotableSubmission } from '../lib/takawo/submissions';
import submissions from '../data/takawo/notable-submissions.json';
import TakawoHeroCardOrbit from './takawo/TakawoHeroCardOrbit';

interface Props {
  theme: Teacher;
}

const { theme } = Astro.props;

const meta = SET_META[theme];
const t = TEACHERS[theme];
const order = String(t.order).padStart(2, '0');

const HERO_VIDEO_POOLS: Partial<Record<Teacher, readonly string[]>> = {
  yao: YAO_HERO_VIDEOS,
  mizuno: MIZUNO_HERO_VIDEOS,
};

const heroVideoPool = HERO_VIDEO_POOLS[theme] ?? [];
const hasVideoGrid = heroVideoPool.length > 0;
const hasMizunoTyping = theme === 'mizuno';
const hasTakawoOrbit = theme === 'takawo';
const hasImmersiveHero = hasVideoGrid || hasMizunoTyping;
const heroInitialVideos = pickSsrHeroVideos(heroVideoPool).map((path) => withBase(path));
const heroOrbitCards = hasTakawoOrbit
  ? buildHeroOrbitCards(submissions as NotableSubmission[], import.meta.env.BASE_URL)
  : [];

/** 「書けるの|か？」のように助詞と語尾が分断されないよう WORD JOINER を挿入 */
function heroQuestionText(question: string): string {
  return question.replace(/([のはが])([かが][？?])/g, '$1\u2060$2');
}
---

<section
  class:list={[
    'theme-hero border-b border-line',
    `theme-hero--${theme}`,
    hasVideoGrid && 'theme-hero--video-grid',
    hasMizunoTyping && 'theme-hero--typing',
    hasTakawoOrbit && 'theme-hero--card-orbit',
    hasImmersiveHero && 'theme-hero--immersive',
  ]}
  style={undefined}
>
  {hasMizunoTyping && (
    <div
      id="mizuno-hero-canvas"
      class="mizuno-hero-canvas"
      data-mizuno-hero-canvas
      aria-hidden="true"
    />
  )}
  {hasVideoGrid && (
    <div class="hero-video-grid" data-hero-video-grid data-hero-theme={theme} aria-hidden="true">
      {heroInitialVideos.map((src) => (
        <video
          class="hero-video"
          src={src}
          muted
          autoplay
          playsinline
          preload="metadata"
        />
      ))}
    </div>
  )}
  {hasTakawoOrbit && (
    <div class="takawo-orbit-host" data-takawo-orbit>
      <TakawoHeroCardOrbit client:visible cards={heroOrbitCards} />
    </div>
  )}
  <div class="theme-hero__inner mx-auto max-w-5xl px-6">
    <p class="theme-hero__meta hero-mark hero-mark--meta font-mono text-xs uppercase tracking-[0.2em]">
      セット{order}｜{meta.sessions}（{meta.dates}）｜担当：{t.name}
    </p>
    <h1 class="theme-hero__title hero-mark mt-4 font-display text-3xl leading-snug sm:text-4xl">
      {meta.tagline}
    </h1>
    <p class="theme-hero__question hero-mark hero-mark--question mt-4 font-display text-lg leading-snug sm:text-xl">
      「{heroQuestionText(meta.question)}」
    </p>
    {meta.description && !hasTakawoOrbit && (
      <p class="theme-hero__description mt-5 text-sm leading-relaxed text-ink-soft">{meta.description}</p>
    )}
  </div>
</section>

{hasMizunoTyping && (
  <script>
    import { initMizunoHeroTyping } from '../lib/mizuno/hero-typing/init';

    const bootMizunoHero = () => {
      const el = document.querySelector<HTMLElement>('[data-mizuno-hero-canvas]');
      if (el) initMizunoHeroTyping(el);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootMizunoHero, { once: true });
    } else {
      bootMizunoHero();
    }

    document.addEventListener('astro:page-load', bootMizunoHero);
  </script>
)}

{hasVideoGrid && (
  <script>
    import { initAllHeroVideoGrids } from '../lib/hero-video-grid';
    import { MIZUNO_HERO_VIDEOS } from '../data/mizuno/hero-videos';
    import { YAO_HERO_VIDEOS } from '../data/yao/hero-videos';

    const HERO_VIDEO_POOLS = {
      yao: YAO_HERO_VIDEOS,
      mizuno: MIZUNO_HERO_VIDEOS,
    } as const;

    const boot = () => initAllHeroVideoGrids(HERO_VIDEO_POOLS);

    boot();
    document.addEventListener('astro:page-load', boot);
    window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', boot);
  </script>
)}

<style>
  .theme-hero {
    --hero-mark-bg: var(--color-ink);
    position: relative;
    background: var(--color-paper);
  }

  .theme-hero__inner {
    position: relative;
    z-index: 2;
    /* 旧 py-14（3.5rem）の 133% */
    padding-block: calc(3.5rem * 1.33);
  }

  .theme-hero--takawo {
    --hero-mark-bg: var(--color-takawo);
    background-color: var(--color-paper);
  }

  .theme-hero--card-orbit,
  .theme-hero--immersive {
    min-height: min(100svh, 56rem);
    overflow: hidden;
  }

  .theme-hero--card-orbit {
    background:
      radial-gradient(ellipse 85% 70% at 50% 38%, var(--color-takawo-hero-bg-mid) 0%, transparent 62%),
      linear-gradient(168deg, #171d2a 0%, var(--color-takawo-hero-bg) 48%, #0f1218 100%);
    border-bottom-color: rgb(245 242 233 / 0.1);
  }

  .theme-hero--card-orbit::before {
    display: block;
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse 75% 55% at 50% 45%, transparent 35%, rgb(8 10 14 / 0.45) 100%);
  }

  .theme-hero--card-orbit .theme-hero__inner {
    padding-block: 1.75rem 0;
    z-index: 3;
    pointer-events: none;
  }

  .theme-hero--card-orbit .theme-hero__inner :global(.hero-mark) {
    pointer-events: auto;
  }

  .theme-hero--card-orbit .theme-hero__question {
    margin-bottom: 0;
  }

  .takawo-orbit-host {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .theme-hero--immersive .theme-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: min(100svh, 56rem);
    padding-block: clamp(2.75rem, 10vh, 5rem);
  }

  .theme-hero--immersive .hero-mark--meta {
    font-size: 0.6875rem;
    padding: 0.3em 0.55em;
    letter-spacing: 0.18em;
  }

  .theme-hero--immersive .theme-hero__title {
    font-size: clamp(2.125rem, 5.2vw, 3.5rem);
    line-height: 1.32;
    margin-top: 1.25rem;
  }

  .theme-hero--immersive .theme-hero__question {
    font-size: clamp(1.375rem, 2.9vw, 2rem);
    line-height: 1.42;
    margin-top: 1.25rem;
    max-width: 37ch;
  }

  .theme-hero--immersive .theme-hero__description {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.7;
    margin-top: 1.5rem;
    max-width: 42rem;
  }

  .theme-hero--mizuno {
    --hero-mark-bg: rgb(63 90 115 / 0.65);
    background: color-mix(in srgb, var(--color-mizuno-tint) 55%, var(--color-paper));
  }

  .theme-hero--yao {
    --hero-mark-bg: var(--color-yao);
    background: color-mix(in srgb, var(--color-yao-tint) 55%, var(--color-paper));
  }

  .theme-hero--video-grid {
    overflow: hidden;
  }

  .theme-hero--video-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--color-paper) 38%, transparent);
    pointer-events: none;
  }

  .theme-hero--typing {
    overflow: hidden;
  }

  .theme-hero--typing::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--color-paper) 22%, transparent);
    pointer-events: none;
  }

  .mizuno-hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    pointer-events: none;
  }

  .mizuno-hero-canvas :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
  }

  .hero-video-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    height: 100%;
    overflow: hidden;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center center;
    display: block;
    opacity: 1;
  }

  @media (min-width: 640px) {
    .hero-video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .hero-video-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-mark {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    position: relative;
    z-index: 1;
    background-color: var(--hero-mark-bg);
    color: var(--color-paper);
    padding: 0.2em 0.45em;
    line-height: 1.55;
    line-break: strict;
    overflow-wrap: normal;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-mark--meta {
    padding: 0.25em 0.5em;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    line-height: 1.6;
  }

  .hero-mark--question {
    padding: 0.18em 0.42em;
    line-height: 1.5;
  }

  .theme-hero__meta {
    margin: 0;
  }

  .theme-hero__title,
  .theme-hero__question {
    margin-top: 1rem;
  }

  .theme-hero__meta + .theme-hero__title {
    margin-top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-hero--card-orbit,
    .theme-hero--immersive {
      min-height: min(100svh, 44rem);
    }

    .theme-hero--immersive .theme-hero__inner {
      min-height: min(100svh, 44rem);
    }
  }
</style>
